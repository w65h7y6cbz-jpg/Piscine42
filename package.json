{
  "name": "escape42",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Escape 42 — La Villa Nul. Escape game d'entraînement à la piscine 42.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "chaine-c": "node scripts/recuperer-chaine-c.mjs",
    "dev": "npm run chaine-c && vite",
    "build": "npm run chaine-c && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "wrangler": "^3.80.0"
  }
}
